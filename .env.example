# ── Database ──────────────────────────────────────
# Para dev local (Python nativo + compose postgres): host = localhost
# Para Docker (compose api + postgres): host é sobrescrito no docker-compose.yml
SMART_PACE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_pace

# ── CORS ─────────────────────────────────────────
# Origens permitidas (separar por vírgula). "*" permite todas.
SMART_PACE_CORS_ALLOWED_ORIGINS=*

# ── JWT ───────────────────────────────────────────
# IMPORTANTE: gere um segredo forte antes de usar!
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SMART_PACE_JWT_SECRET_KEY=change-me-in-production
SMART_PACE_JWT_ALGORITHM=HS256
SMART_PACE_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
SMART_PACE_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
